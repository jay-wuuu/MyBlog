<%
  var tocContent = toc(page.content, {
    max_depth: theme.toc.max_depth,
    min_depth: 1,
    list_number: false
  });
  var hasToc = !!tocContent && tocContent.trim().length > 0;

  var showComments = page.comments;
  if (showComments === undefined) {
    showComments = theme.comments.enable;
  }
%>

<!-- 文章内容 -->
<div class="body-container">
  <article class="content-container layout-block post-container">
    <div class="article-info">
      <%# 如果文章设置了photos内容 %>
      <% if (page.photos && page.photos.length) { %>
      <section class="article-entry markdown-body layout-margin content-padding--large soft-size--large soft-style--box">
        <% page.photos.forEach(function(photo, i) { %>
          <p>
            <a href="<%- url_for(photo) %>" target="_blank">
              <img src="<%- url_for(photo) %>" itemprop="image" loading="lazy" />
            </a>
          </p>
        <% }) %>
      </section>
      <% } %>

      <%# 输出Markdown内容 %>
      <section class="article-entry markdown-body layout-margin content-padding--large soft-size--large soft-style--box">
        <%- page.content %>
      </section>

      <%# 输出上一篇，下一篇内容 %>
      <% if (page.prev || page.next){ %>
        <nav class="article-nav">
          <% if (page.prev) { %>
            <%- partial("../_widget/article-nav", { page: page.prev, keyword: 'newer' }) %>
          <% } %>
          <% if (page.next) { %>
            <%- partial("../_widget/article-nav", { page: page.next, keyword: 'older' }) %>
          <% } %>
        </nav>
      <% } %>
    </div>

    <div class="widget-info">
      <%- partial("../_widget/widget-author") %>
      <%- partial("../_widget/widget-notice") %>
      <%- partial("../_widget/widget-categories") %>
      <%- partial("../_widget/widget-tags") %>
    </div>
  </article>
</div>

<%# 左侧固定目录栏（利用屏幕留白） %>
<% if (hasToc) { %>
<aside class="toc-sidebar" id="toc-sidebar">
  <div class="toc-sidebar__panel">
    <div class="toc-sidebar__title">
      <%- partial("../_svg/icon-toc.svg") %>
      <span>TOC</span>
    </div>
    <div class="toc-sidebar__body">
      <%- tocContent %>
    </div>
  </div>
  <button class="toc-sidebar__toggle" id="toc-toggle" type="button" aria-label="toggle toc">
    <span class="toc-toggle__arrow">❯</span>
  </button>
</aside>
<% } %>

<%# 底部评论按钮 + 抽屉 %>
<% if (showComments) { %>
<button class="comment-fab soft-size--primary soft-style--box" id="comment-fab" type="button">
  <%- partial("../_svg/icon-comment.svg") %>
  <span>评论</span>
</button>
<div class="comment-drawer__mask" id="comment-mask"></div>
<div class="comment-drawer" id="comment-drawer">
  <div class="comment-drawer__header">
    <span>评论</span>
    <button class="comment-drawer__close" id="comment-close" type="button" aria-label="close comments">✕</button>
  </div>
  <div class="comment-drawer__body">
    <%- partial('../_widget/comment', { post: page }) %>
  </div>
</div>
<% } %>
