/** page list */
.content-container.article-list {
  display: flex
  flex-wrap: wrap

  .article-item {
    flex: 1 0 auto
    min-width: 25%
    max-width: 100%
  }

  .card-container.article-card {
    padding: var(--content-large-padding)
  }
}


/** post content */
.content-container.post-container {
  display: flex
  align-items: flex-start;
  overflow: visible;

  .article-info {
    // 文章导航
    .article-nav {
      display: flex
      width: 100%
      overflow: hidden

      .article-nav-item {
        flex: 1 1 auto
        min-width: 50%
        text-align: center
      }
    }

    /** link page 独立内容 */
    .page-link-container {
      display: flex
      flex-direction: row
      flex-wrap: wrap
      justify-content: center

      .link-item {
        @media $mq-pc {
          max-width: 100%;
          min-width: 33.333%;
          flex: 1 0 auto;
        }

        @media $mq-mb {
          max-width: 100%;
          flex: 1 1 50%;
        }

        > a {
          display: flex;
          align-items: center;
          transition: color 0.3s ease;
          height: 100%;
      
          img {
            display: block;
            width: 46px;
            min-width: 46px;
            height: 46px;
            margin-right: 12px;
            object-fit: cover;
            flex: 0 0 46px;
          }
      
          div {
            overflow: hidden;
            line-height: var(--font-base-lh);
          }
      
          h4 {
            font-weight: bold;
            color: var(--theme-text-stress);
          }
      
          p {
            color: var(--theme-text-primary);
          }
        }
      }
    }
  }

  .widget-info {
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    width: 360px;
    min-width: 360px;
    color: var(--theme-text-primary)

    .widget-title {
      display: flex;
      align-items: center;
      font-size: var(--font-stress-size)
      font-weight: bolder
      margin-bottom: 12px

      svg {
        display: block;
        width: 32px;
        height: 32px;
        margin-right: 8px;
      }
    }

    .widget-author .widget-body {
      display: flex;
      flex-direction: column;
      align-items: center;

      img {
        width: 60px;
        height: 60px;
        display: block;
      }

      h2 {
        font-weight: bolder
        font-size: var(--font-stress-size)
        line-height: var(--font-base-lh)
      }

      .count-box {
        display: flex;
        width: 100%;
        margin-top: 16px;

        .count-box--item {
          display: flex
          align-items: center
          justify-content: center
          flex: 0 0 33.3333%

          svg {
            width: 24px;
            height: 24px;
            margin-right: 8px;
          }
        }
      }
    }

    .widget-site .widget-body {
      .site-info {
        display: flex
        flex-direction: column
        gap: 10px 0

        .site-info-item {
          color: var(--theme-text-primary)
        }
      }
    }

    .widget-toc .widget-body {
      ol {
        &:not(:first-child) {
          padding-left: 20px;
        }

        > li {
          margin: 16px 0;

          &::marker {
            color: var(--theme-text-primary);
          }

          > a {
            color: var(--theme-text-primary);
            transition: color 0.3s ease;

            &:hover {
              color: var(--theme-text-active);
            }
          }
        }
      }
    }

    .widget-categories .widget-body {
      .categories-list-item {
        &:not(:last-child) {
          margin-bottom: 14px
        }

        a {
          color: var(--theme-text-primary)
          transition: color 0.3s ease, border-color 0.3s ease
          font-weight: bolder
          border-bottom: 2px solid var(--theme-border-primary)

          &:hover {
            color: var(--theme-text-active)
            border-color: var(--theme-text-active)
          }
        }
      }
    }

    .widget-tags .widget-body {
      .tags-cloud {
        display: flex
        flex-wrap: wrap
        align-items: center;
        margin: 0 -8px;

        a {
          margin: 3px
          display: block
          padding: 4px 8px
          color: var(--theme-text-primary)
          transition: box-shadow 0.3s ease

          &:hover {
            soft-box(var(--soft-small-radius))
          }
        }
      }
    }
  }

  @media $mq-pc {
    .article-info {
      flex: 0 1 calc(100% - 360px)
      min-width: calc(100% - 360px)
    }
    .widget-info {
      display: flex;
    }
  }

  @media $mq-mb {
    .article-info {
      flex: 1 1 100%;
      width: 100%;
    }
    .widget-info {
      display: none;
    }
  }
}


/** 左侧固定目录栏（利用屏幕留白，不占正文宽度） */
.toc-sidebar {
  position: fixed
  left: 0
  top: 0
  z-index: 15
  display: flex
  align-items: stretch
  height: 100vh
  width: 280px
  transform: translateX(0)
  transition: transform 0.3s ease

  .toc-sidebar__panel {
    flex: 1 1 auto
    min-width: 0
    min-height: 0
    margin: var(--layout-padding) 0 var(--layout-padding) var(--layout-padding)
    padding: var(--content-primary-padding)
    soft-box(var(--soft-primary-radius))
    overflow-y: auto
    overscroll-behavior: contain
  }

  .toc-sidebar__title {
    display: flex
    align-items: center
    font-size: var(--font-stress-size)
    font-weight: bolder
    margin-bottom: 12px
    color: var(--theme-text-primary)

    svg {
      display: block
      width: 32px
      height: 32px
      margin-right: 8px
    }
  }

  .toc-sidebar__body {
    color: var(--theme-text-primary)

    ol {
      list-style: none
      padding-left: 0
      margin: 0

      &:not(:first-child) {
        padding-left: 20px
      }

      > li {
        margin: 12px 0

        > a {
          display: block
          color: var(--theme-text-primary)
          transition: color 0.3s ease, border-color 0.3s ease
          border-left: 2px solid transparent
          padding-left: 8px

          &:hover {
            color: var(--theme-text-active)
          }

          &.active {
            color: var(--theme-text-active)
            border-left-color: var(--theme-text-active)
            font-weight: bolder
          }
        }
      }
    }
  }

  .toc-sidebar__toggle {
    flex: 0 0 40px
    display: flex
    align-items: center
    justify-content: center
    padding: 0
    cursor: pointer
    border: none
    background: none
    color: var(--theme-text-low)
    transition: color 0.3s ease

    &:hover {
      color: var(--theme-text-active)
    }

    .toc-toggle__arrow {
      display: block
      font-size: 20px
      transition: transform 0.3s ease
    }
  }

  &:not(.collapsed) .toc-toggle__arrow {
    transform: rotate(180deg)
  }

  &.collapsed {
    transform: translateX(calc(-100% + 40px))
  }
}

@media $mq-mb {
  .toc-sidebar {
    display: none;
  }
}


/** 底部评论按钮 */
.comment-fab {
  position: fixed
  left: auto
  right: 40px
  bottom: 40px
  width: max-content
  z-index: 20
  display: flex
  align-items: center
  gap: 8px
  padding: 12px 20px
  cursor: pointer
  border: none
  color: var(--theme-text-primary)
  transition: transform 0.3s ease, color 0.3s ease

  svg {
    width: 22px
    height: 22px
    fill: var(--theme-text-primary)
    transition: fill 0.3s ease
  }

  span {
    font-size: var(--font-common-size)
    font-weight: bolder
  }

  &:hover {
    transform: translateY(-2px)
    color: var(--theme-text-active)

    svg {
      fill: var(--theme-text-active)
    }
  }
}

/** 评论抽屉遮罩 */
.comment-drawer__mask {
  position: fixed
  inset: 0
  z-index: 25
  background-color: rgba(0, 0, 0, 0.4)
  opacity: 0
  pointer-events: none
  transition: opacity 0.35s ease

  &.show {
    opacity: 1
    pointer-events: auto
  }
}

/** 评论抽屉 */
.comment-drawer {
  position: fixed
  left: 0
  right: 0
  bottom: 0
  z-index: 30
  height: 60vh
  display: flex
  flex-direction: column
  background-color: var(--theme-bg-primary)
  border-radius: var(--soft-primary-radius) var(--soft-primary-radius) 0 0
  box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.15)
  transform: translateY(105%)
  transition: transform 0.35s ease

  &.open {
    transform: translateY(0)
  }

  .comment-drawer__header {
    display: flex
    align-items: center
    justify-content: space-between
    padding: 16px 24px
    border-bottom: 1px solid var(--theme-border-secondary)
    color: var(--theme-text-primary)
    font-size: var(--font-stress-size)
    font-weight: bolder

    .comment-drawer__close {
      cursor: pointer
      border: none
      background: none
      font-size: 18px
      color: var(--theme-text-low)
      transition: color 0.3s ease

      &:hover {
        color: var(--theme-text-active)
      }
    }
  }

  .comment-drawer__body {
    flex: 1 1 auto
    overflow-y: auto
    padding: 16px 24px

    .comments-container {
      padding: 0
    }
  }
}